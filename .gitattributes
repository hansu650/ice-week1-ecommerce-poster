* text=auto
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Preserve the exact checked final-delivery bytes and suppress enormous diffs.
poster/final/*.svg binary
poster/final/*.pdf binary
poster/final/*.png binary
poster/assets/qr/*.svg binary

# Current measured outputs and historical originals retain exact bytes.
poster/final/*.html binary
poster/modules/*.svg binary
poster/modules/*.pdf binary
poster/history/**/*.svg binary
poster/history/**/*.pdf binary
poster/history/**/*.png binary
